# LLM API 配置 — DeepSeek 官方格式
# 官方文档: https://api-docs.deepseek.com
# base_url (OpenAI 兼容): https://api.deepseek.com
# api_key: 在 platform.deepseek.com 申请
# model:   deepseek-flash
# 可选参数: DEEPSEEK_THINKING=enabled | disabled (思考模式)
#          DEEPSEEK_REASONING_EFFORT=low | medium | high (推理强度)

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# 其他兼容 API 示例：
# Moonshot: OPENAI_BASE_URL=https://api.moonshot.cn/v1  OPENAI_MODEL=moonshot-v1-8k
# 本地 Ollama: OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=qwen2.5:7b