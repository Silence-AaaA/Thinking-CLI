{
  "name": "thinking-agent",
  "version": "0.4.6",
  "description": "A CLI coding agent built for learning Agent architecture",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "thinking": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "repl": "tsx src/cli/index.ts --repl",
    "test": "tsx src/test.ts",
    "test:phase2": "tsx src/test-observation.ts",
    "test:phase3": "tsx src/test-phase3.ts",
    "test:bypass": "tsx src/test-bypass.ts",
    "test:phase3-exec": "tsx src/test-phase3-exec.ts",
    "test:phase4": "tsx src/test-phase4.ts",
    "test:all": "tsx src/test.ts && tsx src/test-observation.ts && tsx src/test-phase3.ts && tsx src/test-phase3-exec.ts && tsx src/test-phase4.ts"
  },
  "keywords": ["agent", "cli", "llm", "react"],
  "author": "",
  "license": "MIT"
}




